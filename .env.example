# Copy this file to .env and change the passwords.
# .env is in .gitignore - never commit real passwords.

DB_NAME=toxic_chemical
DB_ROOT_PASSWORD=change-me-root

# Admin account: full rights on the toxic_chemical database (for you, not the app)
DB_ADMIN_USER=tc_admin
DB_ADMIN_PASSWORD=change-me-admin

# App account: only the rights the app needs (see db/03_app_user.sh)
DB_APP_USER=tc_app
DB_APP_PASSWORD=change-me-app

# Used by Flask to sign session cookies
SECRET_KEY=change-me-to-a-long-random-string
